# Copy to .dev.vars for `wrangler dev`. Optional when running via `bun run dev`
# (portless) — that injects API_URL and MCP_URL automatically.

API_URL=
MCP_URL=
# OAuth metadata is advertised from this, so set it to your local MCP URL + /mcp (defaults to prod).
MCP_RESOURCE=

#(optional)
POSTHOG_API_KEY=
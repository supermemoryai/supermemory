# Copy to .dev.vars for `wrangler dev`. Optional when running via `bun run dev`
# (portless) — that injects API_URL and MCP_URL automatically.

API_URL=
MCP_URL=

# Optional comma-separated browser Origin hostnames beyond the built-in list.
ALLOWED_MCP_ORIGIN_HOSTNAMES=

# Optional
POSTHOG_API_KEY=

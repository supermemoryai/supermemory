{
	"compilerOptions": {
		"incremental": true,
		"jsx": "preserve",
		"paths": {
			"@/*": ["./*"]
		},
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"exclude": ["node_modules"],
	"extends": "@total-typescript/tsconfig/bundler/dom/app",
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"]
}

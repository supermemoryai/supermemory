{
  "name": "supermemory",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:local": "turbo run dev:app",
    "format-lint": "bunx biome check --write",
    "check-types": "turbo run check-types",
    "sentry:sourcemaps": "_SENTRY_RELEASE=$(sentry-cli releases propose-version) && sentry-cli releases new $_SENTRY_RELEASE --org=supermemory --project=consumer-app && sentry-cli sourcemaps upload --org=supermemory --project=consumer-app --release=$_SENTRY_RELEASE --strip-prefix 'dist/..' dist",
    "postbuild": "bun run sentry:sourcemaps"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "!apps/raycast-extension",
    "!tools/test/chatapp",
    "packages/*"
  ],
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/cerebras": "^0.2.16",
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/openai": "^2.0.42",
    "@anthropic-ai/sdk": "^0.55.1",
    "@google/genai": "^1.10.0",
    "@google/generative-ai": "^0.24.1",
    "@hono/zod-validator": "^0.7.1",
    "@scalar/hono-api-reference": "^0.9.11",
    "@types/flubber": "^0.4.0",
    "@vanilla-extract/recipes": "^0.5.7",
    "ai": "^5.0.59",
    "alchemy": "^0.81.4",
    "atmn": "^0.0.16",
    "better-auth": "1.7.6",
    "boxen": "^8.0.1",
    "cloudflare": "^4.5.0",
    "compromise": "^14.14.4",
    "dedent": "^1.6.0",
    "destr": "^2.0.5",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "~0.7.1",
    "file-type": "^21.0.0",
    "hono-openapi": "^0.4.8",
    "nanoid": "^5.1.16",
    "neverthrow": "^8.2.0",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "postgres": "^3.4.7",
    "random-word-slugs": "^0.1.7",
    "resend": "^4.7.0",
    "zod": "^3.25.76",
    "zod-openapi": "^4.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@sentry/cli": "^2.52.0",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.4",
    "turbo": "^2.5.4",
    "typescript": "5.8.3",
    "wrangler": "^4.42.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "adm-zip": "0.6.1",
    "axios": "1.20.0",
    "basic-ftp": "6.2.1",
    "browserslist": "4.28.7",
    "defu": "6.1.5",
    "engine.io": "6.6.11",
    "fast-uri": "3.1.8",
    "fast-xml-builder": "1.3.1",
    "fast-xml-parser": "5.7.3",
    "form-data": "4.0.6",
    "hono": "4.13.12",
    "ip-address": "10.7.3",
    "jsondiffpatch": "0.7.6",
    "lodash": "4.18.1",
    "node-forge": "1.4.0",
    "postcss": "8.5.23",
    "protobufjs": "7.6.6",
    "sharp": "0.35.4",
    "socket.io-parser": "4.2.7",
    "undici": "7.29.1",
    "ws": "8.21.3"
  },
  "workerd": {
    "import": "./esm/index.mjs",
    "require": "./dist/index.js"
  }
}

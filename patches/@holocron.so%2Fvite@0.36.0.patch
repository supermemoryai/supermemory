+      className='api-playground fixed inset-4 m-auto max-h-[90vh] w-[min(1200px,95vw)] overflow-auto rounded-xl border border-border-subtle bg-background p-6 text-foreground shadow-xl backdrop:bg-black/40'
+    >
+      <div className='mb-5 flex items-center justify-between gap-3'>
+        <h2 className='text-lg font-semibold'>
+          {props.summary ?? `${props.method.toUpperCase()} ${props.path}`}
+        </h2>
+        <button
+          type='button'
+          className={button}
+          onClick={props.onClose}
+          aria-label='Close API playground'
+        >
+          Close
+        </button>
+      </div>
+      <div className='grid gap-6 lg:grid-cols-2'>
+        <form onSubmit={send} className='flex min-w-0 flex-col gap-4'>
+          <label className='flex flex-col gap-2'>
+            Server URL
+            <input
+              className={control}
+              aria-label='Server URL'
+              type='url'
+              required
+              value={server}
+              list='api-playground-servers'
+              onChange={(event) => {
+                setServer(event.target.value)
+                setCredentials({})
+                setHeaders((current) =>
+                  clearPlaygroundSecretHeaders(props, current),
+                )
+                setParameters((current) =>
+                  clearPlaygroundSecretParameters(props, current),
+                )
+                setResponse(undefined)
+              }}
+            />
+            <datalist id='api-playground-servers'>
+              {props.servers.map((s) => (
+                <option key={s.url} value={s.url}>
+                  {s.description}
+                </option>
+              ))}
+            </datalist>
+          </label>
+          <code className='break-all text-xs'>
+            {props.method.toUpperCase()} {props.path}
+          </code>
+          <fieldset className='flex flex-col gap-3 rounded-lg border border-border-subtle p-4'>
+            <legend className='px-1 font-semibold'>Authorization</legend>
+            {requirements.length > 1 && (
+              <select
+                className={control}
+                aria-label='Authentication method'
+                value={securityIndex}
+                onChange={(event) => {
+                  setSecurityIndex(Number(event.target.value))
+                  setCredentials({})
+                }}
+              >
+                {requirements.map((names, index) => (
+                  <option key={index} value={index}>
+                    {names.join(' + ') || 'No authentication'}
+                  </option>
+                ))}
+              </select>
+            )}
+            {security.length === 0 && (
+              <span className='text-muted-foreground'>
+                No authentication required.
+              </span>
+            )}
+            {security.map((s) => (
+              <label className='flex flex-col gap-2' key={s.name}>
+                {s.name}{' '}
+                {s.scheme === 'bearer'
+                  ? '(Bearer token)'
+                  : s.scheme === 'basic'
+                    ? '(username:password)'
+                    : s.parameterName
+                      ? `(${s.parameterName})`
+                      : ''}
+                <input
+                  className={control}
+                  type='password'
+                  aria-label={`${s.name} credential`}
+                  autoComplete='off'
+                  data-lpignore='true'
+                  value={credentials[s.name] ?? ''}
+                  onChange={(event) =>
+                    setCredentials({
+                      ...credentials,
+                      [s.name]: event.target.value,
+                    })
+                  }
+                />
+              </label>
+            ))}
+            <span className='text-xs text-muted-foreground'>
+              Credentials stay in this open playground and are sent only to the
+              API you select. Closing clears them. Changing servers clears
+              authentication.
+            </span>
+            {unsupported && (
+              <p role='alert'>
+                This authentication scheme cannot be used safely here. Query and
+                cookie credentials are not supported.
+              </p>
+            )}
+          </fieldset>
+          {(['path', 'query', 'header', 'cookie'] as const).map((location) => {
+            const fields = props.parameters.filter((p) => p.in === location)
+            return (
+              fields.length > 0 && (
+                <fieldset
+                  className='flex flex-col gap-3 rounded-lg border border-border-subtle p-4'
+                  key={location}
+                >
+                  <legend className='px-1 font-semibold'>
+                    {location.charAt(0).toUpperCase() + location.slice(1)}{' '}
+                    parameters
+                  </legend>
+                  {fields.map((parameter) => (
+                    <label className='flex flex-col gap-1' key={parameter.name}>
+                      {parameter.name}
+                      {parameter.required ? ' (required)' : ''}
+                      <span className='text-xs text-muted-foreground'>
+                        {parameter.description}
+                      </span>
+                      <input
+                        className={control}
+                        aria-label={`${location} ${parameter.name}`}
+                        required={parameter.required}
+                        value={
+                          parameters[`${location}:${parameter.name}`] ?? ''
+                        }
+                        placeholder={
+                          parameter.schema?.type === 'array'
+                            ? 'JSON array'
+                            : parameter.schema?.type === 'object'
+                              ? 'JSON object'
+                              : String(
+                                  parameter.example ??
+                                    parameter.schema?.example ??
+                                    parameter.schema?.default ??
+                                    '',
+                                )
+                        }
+                        onChange={(event) =>
+                          setParameters({
+                            ...parameters,
+                            [`${location}:${parameter.name}`]:
+                              event.target.value,
+                          })
+                        }
+                      />
+                    </label>
+                  ))}
+                </fieldset>
+              )
+            )
+          })}
+          <details>
+            <summary className='cursor-pointer'>Additional headers</summary>
+            <label className='mt-2 flex flex-col gap-1'>
+              JSON object
+              <textarea
+                className={`${control} font-mono`}
+                aria-label='Additional headers (JSON)'
+                rows={3}
+                value={headers}
+                onChange={(event) => setHeaders(event.target.value)}
+              />
+            </label>
+          </details>
+          {props.requestBody && (
+            <fieldset className='flex flex-col gap-4 rounded-lg border border-border-subtle p-4'>
+              <legend className='px-1 font-semibold'>
+                Body · {props.requestBody.contentType}
+              </legend>
+              {props.requestBody.examples &&
+                props.requestBody.examples.length > 1 && (
+                  <select
+                    className={control}
+                    aria-label='Body example'
+                    value={bodyExample}
+                    onChange={(event) => {
+                      setBodyExample(Number(event.target.value))
+                      setBody(
+                        props.requestBody?.examples?.[
+                          Number(event.target.value)
+                        ]?.value,
+                      )
+                      setRawBody(false)
+                    }}
+                  >
+                    {props.requestBody.examples.map((value, index) => (
+                      <option key={index} value={index}>
+                        {value.name}
+                      </option>
+                    ))}
+                  </select>
+                )}
+              {properties && (
+                <button
+                  type='button'
+                  className={button}
+                  onClick={() => setRawBody(!rawBody)}
+                >
+                  {rawBody ? 'Edit fields' : 'Edit JSON'}
+                </button>
+              )}
+              {properties && !rawBody ? (
+                <>
+                  {Object.entries(properties)
+                    .filter(
+                      ([name, field]) =>
+                        !field.readOnly &&
+                        (optional ||
+                          schema?.required?.includes(name) ||
+                          (body as Record<string, unknown> | undefined)?.[
+                            name
+                          ] !== undefined),
+                    )
+                    .map(([name, field]) => (
+                      <BodyField
+                        key={`${name}:${bodyExample}`}
+                        name={name}
+                        schema={field}
+                        value={
+                          (body as Record<string, unknown> | undefined)?.[name]
+                        }
+                        required={schema?.required?.includes(name)}
+                        multipart={
+                          props.requestBody?.contentType ===
+                          'multipart/form-data'
+                        }
+                        onChange={(value) =>
+                          setBody({
+                            ...((body as Record<string, unknown>) ?? {}),
+                            [name]: value,
+                          })
+                        }
+                      />
+                    ))}
+                  {Object.keys(properties).some(
+                    (name) => !schema?.required?.includes(name),
+                  ) && (
+                    <button
+                      type='button'
+                      className={button}
+                      onClick={() => setOptional(!optional)}
+                    >
+                      {optional
+                        ? 'Hide optional fields'
+                        : 'Expand optional fields'}
+                    </button>
+                  )}
+                </>
+              ) : (
+                <BodyField
+                  key={`${rawBody ? 'raw' : 'body'}:${bodyExample}`}
+                  name='Request body'
+                  schema={
+                    props.requestBody.contentType.includes('json')
+                      ? { type: 'object' }
+                      : (schema ?? { type: 'string' })
+                  }
+                  value={body}
+                  required={props.requestBody.required}
+                  onChange={setBody}
+                />
+              )}
+            </fieldset>
+          )}
+          {error && (
+            <p role='alert' className='text-sm text-red-600'>
+              {error}
+            </p>
+          )}
+          <div className='flex gap-2'>
+            <button
+              type='submit'
+              className={`${button} bg-foreground text-background`}
+              disabled={pending || unsupported}
+            >
+              {pending ? 'Sending…' : 'Send request'}
+            </button>
+            {pending && (
+              <button
+                type='button'
+                className={button}
+                onClick={() => abort.current?.abort()}
+              >
+                Cancel request
+              </button>
+            )}
+          </div>
+        </form>
+        <div className='flex min-w-0 flex-col gap-4'>
+          {samples.length > 0 && (
+            <section className='flex flex-col gap-2'>
+              <h3 className='font-semibold'>Request example</h3>
+              <select
+                className={control}
+                aria-label='Code example language'
+                value={example}
+                onChange={(event) => setExample(Number(event.target.value))}
+              >
+                {samples.map((s, index) => (
+                  <option key={index} value={index}>
+                    {s.label}
+                  </option>
+                ))}
+              </select>
+              <p className='text-xs text-muted-foreground'>
+                Documentation examples are unchanged templates, not the request
+                being sent.
+              </p>
+              <pre className='max-h-[400px] overflow-auto rounded-lg border border-border-subtle p-4 text-xs'>
+                <code>{samples[example]?.source}</code>
+              </pre>
+              <button
+                type='button'
+                className={button}
+                onClick={() =>
+                  navigator.clipboard?.writeText(samples[example]?.source ?? '')
+                }
+              >
+                Copy example
+              </button>
+            </section>
+          )}
+          <section className='flex flex-col gap-2' aria-live='polite'>
+            <h3 className='font-semibold'>Response</h3>
+            {response ? (
+              <>
+                <output className='font-mono'>
+                  {response.status} · {response.elapsed} ms
+                </output>
+                <pre className='max-h-[500px] overflow-auto rounded-lg border border-border-subtle p-4 text-xs'>
+                  <code>{response.body || '(empty response)'}</code>
+                </pre>
+                <details>
+                  <summary className='cursor-pointer'>Response headers</summary>
+                  <pre className='overflow-auto p-3 text-xs'>
+                    {response.headers}
+                  </pre>
+                </details>
+              </>
+            ) : responseExamples.length > 0 ? (
+              <>
+                <select
+                  className={control}
+                  aria-label='Response example status'
+                  value={responseExample}
+                  onChange={(event) =>
+                    setResponseExample(Number(event.target.value))
+                  }
+                >
+                  {responseExamples.map((response, index) => (
+                    <option key={response.status} value={index}>
+                      {response.status}
+                    </option>
+                  ))}
+                </select>
+                <p className='text-xs text-muted-foreground'>
+                  Example response. Send a request to see the actual response.
+                </p>
+                <pre className='max-h-[500px] overflow-auto rounded-lg border border-border-subtle p-4 text-xs'>
+                  <code>
+                    {JSON.stringify(
+                      responseExamples[responseExample]?.example,
+                      null,
+                      2,
+                    )}
+                  </code>
+                </pre>
+              </>
+            ) : (
+              <p className='text-sm text-muted-foreground'>
+                Send a request to view its status and response.
+              </p>
+            )}
+          </section>
+        </div>
+      </div>
+    </dialog>
+  )
+}
+
+export function APIPlayground(props: OpenAPIEndpointProps) {
+  const [open, setOpen] = useState(false)
+  return (
+    <>
+      <button
+        type='button'
+        className={`${button} ml-auto whitespace-nowrap`}
+        onClick={() => setOpen(true)}
+      >
+        Try it
+      </button>
+      {open && <PlaygroundDialog {...props} onClose={() => setOpen(false)} />}
+    </>
+  )
+}

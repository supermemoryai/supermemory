@@ -0,0 +1,405 @@
+import type { OpenAPIEndpointProps, SchemaInfo } from './render-openapi.tsx'
+
+function validateBody(
+  value: unknown,
+  schema: SchemaInfo,
+  name = 'body',
+  depth = 0,
+): void {
+  if (depth > 16 || value === undefined) return
+  if (value === null && schema.nullable) return
+  if (schema.type === 'null' && value !== null)
+    throw new Error(`${name} must be null.`)
+  if (
+    schema.const !== undefined &&
+    JSON.stringify(value) !== JSON.stringify(schema.const)
+  )
+    throw new Error(`${name} must match its constant value.`)
+  if (
+    schema.enum &&
+    !schema.enum.some(
+      (option) => JSON.stringify(option) === JSON.stringify(value),
+    )
+  )
+    throw new Error(`${name} must match an allowed value.`)
+  const variants = schema.oneOf ?? schema.anyOf
+  if (variants) {
+    for (const variant of variants) {
+      try {
+        validateBody(value, variant, name, depth + 1)
+        return
+      } catch {}
+    }
+    throw new Error(`${name} does not match an allowed schema.`)
+  }
+  for (const child of schema.allOf ?? [])
+    validateBody(value, child, name, depth + 1)
+  if (schema.type === 'array') {
+    if (!Array.isArray(value)) throw new Error(`${name} must be an array.`)
+    if (
+      value.length < (schema.minItems ?? 0) ||
+      (schema.maxItems !== undefined && value.length > schema.maxItems)
+    )
+      throw new Error(`${name} does not meet its item count constraints.`)
+    const items = schema.items
+    if (items)
+      value.forEach((item, index) => {
+        validateBody(item, items, `${name}[${index}]`, depth + 1)
+      })
+  } else if (schema.type === 'object' || schema.properties) {
+    if (!value || typeof value !== 'object' || Array.isArray(value))
+      throw new Error(`${name} must be an object.`)
+    const object = value as Record<string, unknown>
+    for (const field of schema.required ?? [])
+      if (!schema.properties?.[field]?.readOnly && object[field] === undefined)
+        throw new Error(`${name}.${field} is required.`)
+    for (const [field, item] of Object.entries(object)) {
+      const child =
+        schema.properties?.[field] ??
+        (typeof schema.additionalProperties === 'object'
+          ? schema.additionalProperties
+          : undefined)
+      if (!child && schema.additionalProperties === false && item !== undefined)
+        throw new Error(`${name}.${field} is not an allowed property.`)
+      if (child?.readOnly && item !== undefined)
+        throw new Error(`${name}.${field} is read only.`)
+      if (child) validateBody(item, child, `${name}.${field}`, depth + 1)
+    }
+  } else if (schema.type === 'number' || schema.type === 'integer') {
+    if (
+      typeof value !== 'number' ||
+      !Number.isFinite(value) ||
+      (schema.type === 'integer' && !Number.isInteger(value))
+    )
+      throw new Error(`${name} must be a ${schema.type}.`)
+    if (
+      (schema.minimum !== undefined && value < schema.minimum) ||
+      (schema.maximum !== undefined && value > schema.maximum) ||
+      (typeof schema.exclusiveMinimum === 'number' &&
+        value <= schema.exclusiveMinimum) ||
+      (typeof schema.exclusiveMaximum === 'number' &&
+        value >= schema.exclusiveMaximum) ||
+      (schema.exclusiveMinimum === true &&
+        schema.minimum !== undefined &&
+        value <= schema.minimum) ||
+      (schema.exclusiveMaximum === true &&
+        schema.maximum !== undefined &&
+        value >= schema.maximum)
+    )
+      throw new Error(`${name} does not meet its numeric constraints.`)
+  } else if (schema.type === 'boolean' && typeof value !== 'boolean')
+    throw new Error(`${name} must be a boolean.`)
+  else if (schema.type === 'string' && schema.format !== 'binary') {
+    if (typeof value !== 'string') throw new Error(`${name} must be a string.`)
+    if (
+      value.length < (schema.minLength ?? 0) ||
+      (schema.maxLength !== undefined && value.length > schema.maxLength)
+    )
+      throw new Error(`${name} does not meet its length constraints.`)
+    if (schema.pattern && !new RegExp(schema.pattern).test(value))
+      throw new Error(`${name} does not match its pattern.`)
+  }
+}
+
+export interface PlaygroundInput {
+  server: string
+  parameters: Record<string, string>
+  credentials: Record<string, string>
+  securityIndex: number
+  headers: string
+  body?: unknown
+}
+
+function isSecretHeader(props: OpenAPIEndpointProps, name: string) {
+  return (
+    /^(authorization|proxy-authorization|x-api-key|api-key|apikey|x-auth-token|x-access-token)$/i.test(
+      name,
+    ) ||
+    props.security.some(
+      (scheme) =>
+        scheme.type === 'apiKey' &&
+        scheme.in === 'header' &&
+        (scheme.parameterName ?? scheme.name).toLowerCase() ===
+          name.toLowerCase(),
+    )
+  )
+}
+
+export function getPlaygroundSecrets(
+  props: OpenAPIEndpointProps,
+  input: Pick<PlaygroundInput, 'credentials' | 'headers' | 'parameters'>,
+) {
+  const secrets = Object.fromEntries(
+    Object.entries(input.credentials).map(([name, value]) => [
+      name,
+      value.trim(),
+    ]),
+  )
+  try {
+    const headers: unknown = JSON.parse(input.headers || '{}')
+    if (headers && typeof headers === 'object' && !Array.isArray(headers)) {
+      for (const [name, value] of Object.entries(headers))
+        if (
+          isSecretHeader(props, name) &&
+          typeof value === 'string' &&
+          value.trim()
+        )
+          secrets[`extra-header:${name}`] = value.trim()
+    }
+  } catch {}
+  for (const [name, value] of Object.entries(input.parameters))
+    if (
+      name.startsWith('header:') &&
+      isSecretHeader(props, name.slice(7)) &&
+      value.trim()
+    )
+      secrets[name] = value.trim()
+  return secrets
+}
+
+export function clearPlaygroundSecretHeaders(
+  props: OpenAPIEndpointProps,
+  headers: string,
+) {
+  try {
+    const values: unknown = JSON.parse(headers || '{}')
+    if (!values || Array.isArray(values) || typeof values !== 'object')
+      return '{}'
+    return JSON.stringify(
+      Object.fromEntries(
+        Object.entries(values).filter(([name]) => !isSecretHeader(props, name)),
+      ),
+      null,
+      2,
+    )
+  } catch {
+    return '{}'
+  }
+}
+
+export function clearPlaygroundSecretParameters(
+  props: OpenAPIEndpointProps,
+  parameters: Record<string, string>,
+) {
+  return Object.fromEntries(
+    Object.entries(parameters).filter(
+      ([name]) =>
+        !(name.startsWith('header:') && isSecretHeader(props, name.slice(7))),
+    ),
+  )
+}
+
+export function buildPlaygroundRequest(

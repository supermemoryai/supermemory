@@ -0,0 +1,100 @@
+'use client'
+
+import React, { useEffect, useRef, useState } from 'react'
+import { useHolocronDataSafe } from '../router.ts'
+import { openDocumentationAssistant, useDocumentationContext } from './documentation-assistant.tsx'
+
+const labels: Record<string, string> = {
+  copy: 'Copy page', view: 'View as Markdown', assistant: 'Ask Assistant', chatgpt: 'Open in ChatGPT', claude: 'Open in Claude',
+  mcp: 'Copy MCP Server', 'add-mcp': 'Copy MCP install command', cursor: 'Connect to Cursor', vscode: 'Connect to VS Code', 'download-spec': 'Download OpenAPI specification',
+}
+
+const descriptions: Record<string, string> = {
+  copy: 'Copy page as Markdown for LLMs', view: 'View this page as plain text', assistant: 'Ask questions about this page',
+  chatgpt: 'Ask questions about this page', claude: 'Ask questions about this page', mcp: 'Copy MCP Server URL to clipboard',
+  'add-mcp': 'Copy npx command to install MCP Server', cursor: 'Install MCP Server on Cursor', vscode: 'Install MCP Server on VS Code',
+  'download-spec': 'Download the complete OpenAPI specification',
+}
+
+const icons: Record<string, string> = {
+  copy: '/icons/hugeicons/copy-01.svg', view: '/icons/hugeicons/file-02.svg', assistant: '/icons/hugeicons/sparkles.svg',
+  chatgpt: '/images/openai.svg', claude: '/images/claude-code-icon.svg', mcp: '/icons/hugeicons/plug-01.svg',
+  'add-mcp': '/icons/hugeicons/command-line.svg', cursor: '/images/cursor-logo.svg', vscode: '/icons/vscode.svg',
+  'download-spec': '/icons/hugeicons/download-01.svg',
+}
+
+export function PageActions() {
+  const data = useHolocronDataSafe()
+  const context = useDocumentationContext()
+  const [open, setOpen] = useState(false)
+  const [feedback, setFeedback] = useState('')
+  const root = useRef<HTMLDivElement>(null)
+  const trigger = useRef<HTMLButtonElement>(null)
+  const menu = useRef<HTMLDivElement>(null)
+  const options = [...new Set(data?.site.config.contextual?.options ?? ['copy', 'view'])].filter(option => labels[option] && (option !== 'download-spec' || data?.currentPageFrontmatter?.api || data?.currentPageFrontmatter?.openapi))
+  const base = import.meta.env.BASE_URL || '/'
+  const canonicalBase = new URL(base, 'https://supermemory.ai').href.replace(/\/$/, '')
+  const markdownPath = `${new URL(context.url).pathname.replace(/\/$/, '')}${new URL(context.url).pathname.replace(/\/$/, '') === base.replace(/\/$/, '') ? '/index' : ''}.md`
+  const markdownUrl = new URL(markdownPath, 'https://supermemory.ai').href
+  const mcp = `${canonicalBase}/mcp`
+  const config = { name: 'supermemory-docs', type: 'http', url: mcp }
+  const links: Record<string, string> = {
+    view: markdownPath,
+    chatgpt: `https://chatgpt.com/?q=${encodeURIComponent(`Read ${markdownUrl} so I can ask questions about it.`)}`,
+    claude: `https://claude.ai/new?q=${encodeURIComponent(`Read ${markdownUrl} so I can ask questions about it.`)}`,
+    cursor: `cursor://anysphere.cursor-deeplink/mcp/install?name=supermemory-docs&config=${encodeURIComponent(btoa(JSON.stringify({ url: mcp })))}`,
+    vscode: `vscode:mcp/install?${encodeURIComponent(JSON.stringify(config))}`,
+    'download-spec': `${base}openapi.json`,
+  }
+  useEffect(() => {
+    if (!feedback) return
+    const timeout = setTimeout(() => setFeedback(''), 2_000)
+    return () => clearTimeout(timeout)
+  }, [feedback])
+  useEffect(() => {
+    if (!open) return
+    menu.current?.querySelector<HTMLElement>('[role=menuitem]')?.focus()
+    const outside = (event: PointerEvent) => { if (!root.current?.contains(event.target as Node)) setOpen(false) }
+    const escape = (event: KeyboardEvent) => { if (event.key === 'Escape') { event.preventDefault(); setOpen(false); trigger.current?.focus() } }
+    document.addEventListener('pointerdown', outside)
+    document.addEventListener('keydown', escape)
+    return () => { document.removeEventListener('pointerdown', outside); document.removeEventListener('keydown', escape) }
+  }, [open])
+  if (!options.length) return null
+  const copy = async (option: string) => {
+    try {
+      let value = option === 'mcp' ? mcp : `npx -y mcp-remote ${mcp}`
+      if (option === 'copy') {
+        const response = await fetch(markdownPath, { headers: { Accept: 'text/markdown' }, signal: AbortSignal.timeout(10_000) })
+        if (!response.ok) throw new Error('Markdown is unavailable')
+        value = await response.text()
+      }
+      await navigator.clipboard.writeText(value)
+      setFeedback(option === 'copy' ? 'Page copied' : 'Copied')
+    } catch { setFeedback('Could not copy. Please try again.') }
+    setOpen(false)
+    trigger.current?.focus()
+  }
+  return <div ref={root} className='sm-page-actions'>
+    {options.includes('copy') && <button type='button' className='sm-page-copy' onClick={() => void copy('copy')}><span aria-hidden='true' className='sm-page-action-icon' style={{ maskImage: `url(${base}icons/hugeicons/copy-01.svg)`, WebkitMaskImage: `url(${base}icons/hugeicons/copy-01.svg)` }} />Copy page</button>}
+    <button type='button' ref={trigger} className='sm-page-menu-trigger' aria-label='More page actions' aria-haspopup='menu' aria-expanded={open} onClick={() => setOpen(!open)} onKeyDown={event => { if (event.key === 'ArrowDown' || event.key === 'ArrowUp') { event.preventDefault(); setOpen(true) } }}><svg aria-hidden='true' width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' strokeWidth='1.5'><path d='m6 9 6 6 6-6' /></svg></button>
+    <span role='status' className='sm-page-feedback'>{feedback}</span>
+    {open && <div ref={menu} role='menu' aria-label='Page actions' className='sm-page-actions-menu' onKeyDown={event => {
+      const items = Array.from(menu.current?.querySelectorAll<HTMLElement>('[role=menuitem]') ?? [])
+      const index = items.indexOf(document.activeElement as HTMLElement)
+      if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+        event.preventDefault()
+        items[event.key === 'Home' ? 0 : event.key === 'End' ? items.length - 1 : (index + (event.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length]?.focus()
+      } else if (event.key === 'Tab') setOpen(false)
+    }}>
+      {options.map(option => {
+        const image = `${base}${icons[option].replace(/^\//, '')}`
+        const content = <><span aria-hidden='true' className='sm-page-action-icon' style={{ maskImage: `url(${image})`, WebkitMaskImage: `url(${image})` }} /><span className='sm-page-action-label'><span>{labels[option]}{['view', 'chatgpt', 'claude'].includes(option) && <span aria-hidden='true'> ↗</span>}</span><span className='sm-page-action-description'>{descriptions[option]}</span></span></>
+        return links[option] ? <a key={option} role='menuitem' href={links[option]} target={option === 'view' || option === 'chatgpt' || option === 'claude' ? '_blank' : undefined} rel='noopener noreferrer' download={option === 'download-spec' ? 'openapi.json' : undefined} onClick={() => setOpen(false)}>{content}</a> : <button key={option} type='button' role='menuitem' onClick={() => {
+        if (option === 'assistant') { setOpen(false); trigger.current?.focus(); openDocumentationAssistant(context) }
+        else void copy(option)
+      }}>{content}</button>
+      })}
+    </div>}
+  </div>
+}

new file mode 100644
index 0000000000000000000000000000000000000000..98cb8dde2a41f6071c87f1450274b4c4d7789b0f
--- /dev/null
+++ b/src/components/page-feedback.tsx
@@ -0,0 +1,52 @@
+'use client'
+
+import React, { useState } from 'react'
+import '../../src/components/page-feedback.css'
+import { useHolocronData } from '../router.ts'
+import { withBasePath } from '../lib/holocron-url.ts'
+
+export function PageFeedback() {
+  const { site, currentPageHref } = useHolocronData()
+  const [pending, setPending] = useState(false)
+  const [choice, setChoice] = useState<boolean>()
+  const [error, setError] = useState('')
+  const endpoint = site.config.feedback?.endpoint
+  if (!endpoint) return null
+
+  async function vote(helpful: boolean) {
+    if (pending || choice !== undefined) return
+    setPending(true)
+    setError('')
+    try {
+      const target = new URL(withBasePath(endpoint)!, window.location.origin)
+      if (target.origin !== window.location.origin) throw new Error('Invalid endpoint')
+      const response = await fetch(target, {
+        method: 'POST',
+        credentials: 'omit',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ helpful, page: withBasePath(currentPageHref || '/') }),
+      })
+      if (!response.ok) throw new Error('Feedback unavailable')
+      setChoice(helpful)
+    } catch {
+      setError('Could not send feedback. Please try again.')
+    } finally {
+      setPending(false)
+    }
+  }
+
+  return (
+    <div className='sm-page-helpfulness'>
+      <span>Was this page helpful?</span>
+      <div className='sm-page-helpfulness-buttons'>
+        {[true, false].map(helpful => (
+          <button key={String(helpful)} type='button' disabled={pending || choice !== undefined} aria-pressed={choice === helpful} onClick={() => void vote(helpful)}>
+            <svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' strokeWidth='1.5' aria-hidden='true' style={helpful ? undefined : { transform: 'rotate(180deg)' }}><path d='M7 10v11H3V10h4Zm0 0 4-8h2v6h6a2 2 0 0 1 2 2l-2 10H7' /></svg>
+            {helpful ? 'Yes' : 'No'}
+          </button>
+        ))}
+      </div>
+      <p role='status'>{error || (choice !== undefined ? 'Thanks for your feedback.' : '')}</p>
+    </div>
+  )
+}

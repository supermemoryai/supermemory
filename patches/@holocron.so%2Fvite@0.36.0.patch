new file mode 100644
index 0000000000000000000000000000000000000000..44ba17af757d2a507bdd87e629fd453a1e921940
--- /dev/null
+++ b/src/components/documentation-assistant.tsx
@@ -0,0 +1,179 @@
+'use client'
+
+import React, { useEffect, useId, useRef, useState, useSyncExternalStore } from 'react'
+import { useHolocronDataSafe } from '../router.ts'
+import { useShortcutModifier } from './layout/global-search.tsx'
+import { withBasePath } from '../lib/holocron-url.ts'
+import '../../src/components/documentation-assistant.css'
+
+type Context = { url: string; title: string; code?: string }
+type Message = { role: 'user' | 'assistant'; content: string; sources?: { title: string; url: string }[] }
+type State = { open: boolean; draft: string; context?: Context; messages: Message[]; pending: boolean; error: string }
+
+const initial: State = { open: false, draft: '', messages: [], pending: false, error: '' }
+let state = initial
+const listeners = new Set<() => void>()
+const subscribe = (listener: () => void) => { listeners.add(listener); return () => { listeners.delete(listener) } }
+const update = (value: Partial<State>) => { state = { ...state, ...value }; for (const listener of listeners) listener() }
+const useAssistant = () => useSyncExternalStore(subscribe, () => state, () => initial)
+
+export function useDocumentationContext(): Context {
+  const data = useHolocronDataSafe()
+  const base = import.meta.env.BASE_URL || '/'
+  const href = data?.currentPageHref ?? (typeof window !== 'undefined' ? window.location.pathname : base)
+  const pathname = href.startsWith(base) ? href : `${base.replace(/\/$/, '')}${href.startsWith('/') ? href : `/${href}`}`
+  return { url: new URL(pathname, 'https://supermemory.ai').href, title: (data?.currentPageTitle ?? 'Supermemory documentation').slice(0, 200) }
+}
+
+export function useDocumentationAssistantEnabled() {
+  return useHolocronDataSafe()?.site?.config.contextual?.options.includes('assistant') ?? false
+}
+
+export function openDocumentationAssistant(context: Context, question = '') {
+  update({ open: true, context, draft: question, error: '' })
+}
+
+async function sendQuestion(question: string, context: Context) {
+  if (state.pending || !question.trim()) return
+  const history = state.messages.slice(-6).map(({ role, content }) => ({ role, content: content.slice(0, role === 'user' ? 2_000 : 4_000) }))
+  update({ draft: '', pending: true, error: '', messages: [...state.messages, { role: 'user' as const, content: question.trim() }].slice(-11) })
+  try {
+    const response = await fetch(`${import.meta.env.BASE_URL || '/'}api/chat`, {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ question: question.trim(), history, context }),
+      signal: AbortSignal.timeout(45_000),
+    })
+    const data = await response.json() as { answer?: string; sources?: { title: string; url: string }[]; error?: string }
+    if (!response.ok || typeof data.answer !== 'string') throw new Error(data.error ?? 'Could not answer this question')
+    const sources = (data.sources ?? []).filter(source => {
+      try { const url = new URL(source.url); return url.origin === 'https://supermemory.ai' && url.pathname.startsWith('/docs/') } catch { return false }
+    }).slice(0, 6)
+    update({ messages: [...state.messages, { role: 'assistant' as const, content: data.answer.slice(0, 4_000), sources }].slice(-12) })
+  } catch (error) {
+    update({ error: error instanceof Error ? error.message : 'The assistant is unavailable.', draft: question, messages: state.messages.slice(0, -1) })
+  } finally {
+    update({ pending: false })
+  }
+}
+
+export function DocumentationAssistantLauncher() {
+  const context = useDocumentationContext()
+  const enabled = useDocumentationAssistantEnabled()
+  const modifier = useShortcutModifier()
+  if (!enabled) return null
+  return <button id='assistant-entry' type='button' className='sm-assistant-launcher' onClick={() => openDocumentationAssistant(context)} aria-label='Toggle assistant panel' aria-haspopup='dialog' title='Ask Assistant (Ctrl+I or ⌘I)'>
+    <span aria-hidden='true' style={{ width: 16, height: 16, background: 'currentColor', mask: `url(${withBasePath('/icons/hugeicons/sparkles.svg')}) center / contain no-repeat` }} /><span className='sm-assistant-launcher-label'>Ask Assistant</span><kbd style={{ fontSize: 12, color: 'var(--muted-foreground)' }}>{modifier} I</kbd>
+  </button>
+}
+
+export function DocumentationCodeAsk({ code }: { code: string | (() => string) }) {
+  const context = useDocumentationContext()
+  const enabled = useDocumentationAssistantEnabled()
+  if (!enabled) return null
+  return <button type='button' className='sm-assistant-code-ask' aria-label='Ask Assistant about this code' title='Ask Assistant' onClick={() => openDocumentationAssistant({ ...context, code: (typeof code === 'function' ? code() : code).slice(0, 4_000) }, 'Explain this code sample.')}><span aria-hidden='true' style={{ display: 'block', width: 16, height: 16, background: 'currentColor', mask: `url(${withBasePath('/icons/hugeicons/sparkles.svg')}) center / contain no-repeat` }} /></button>
+}
+
+function Conversation({ context, inputRef }: { context: Context; inputRef?: React.RefObject<HTMLTextAreaElement | null> }) {
+  const snapshot = useAssistant()
+  const inputId = useId()
+  const bottom = useRef<HTMLDivElement>(null)
+  useEffect(() => { bottom.current?.scrollIntoView({ block: 'nearest' }) }, [snapshot.messages, snapshot.pending])
+  return <div className='sm-assistant-conversation'>
+    <div className='sm-assistant-messages' role='log' aria-label='Assistant conversation' aria-live='polite'>
+      {snapshot.messages.length === 0 && <p>Ask a question about Supermemory. Answers are grounded in the documentation, with links to sources.</p>}
+      {snapshot.messages.map((message, index) => <div key={index} className={`sm-assistant-message sm-assistant-message-${message.role}`}>
+        <strong>{message.role === 'user' ? 'You' : 'Supermemory'}</strong><div className='sm-assistant-answer'>{message.content}</div>
+        {!!message.sources?.length && <ol aria-label='Sources'>{message.sources.map((source, index) => <li key={`${source.url}-${index}`}><a href={source.url}>{source.title}</a></li>)}</ol>}
+      </div>)}
+      {snapshot.pending && <p role='status'>Searching the docs…</p>}
+      <div ref={bottom} />
+    </div>
+    {snapshot.error && <p role='alert'>{snapshot.error}</p>}
+    <form className='sm-assistant-form' onSubmit={event => { event.preventDefault(); void sendQuestion(snapshot.draft, context) }}>
+      <label className='sm-assistant-label' htmlFor={inputId}>Ask a question</label>
+      <textarea id={inputId} ref={inputRef} value={snapshot.draft} onChange={event => update({ draft: event.target.value })} maxLength={2_000} required rows={3} placeholder='How do I add memory to my agent?' disabled={snapshot.pending} />
+      {context.code && <p className='sm-assistant-context'>Including the selected code sample.</p>}
+      <div className='sm-assistant-form-actions'><button type='button' disabled={snapshot.pending} onClick={() => update({ messages: [], error: '', draft: '', context: { url: context.url, title: context.title } })}>New conversation</button><button type='submit' disabled={snapshot.pending || !snapshot.draft.trim()}>{snapshot.pending ? 'Searching…' : 'Send message'}</button></div>
+      <p className='sm-assistant-context'>Conversation stays in this tab and is not saved as memory.</p>
+    </form>
+  </div>
+}
+
+export function DocumentationAssistantInline() {
+  const context = useDocumentationContext()
+  const enabled = useDocumentationAssistantEnabled()
+  const [question, setQuestion] = useState('')
+  const form = useRef<HTMLFormElement>(null)
+  const [placement, setPlacement] = useState<{ left: number; width: number }>()
+  useEffect(() => {
+    if (!enabled || context.url.endsWith('/ask')) return
+    const element = form.current
+    if (!element?.closest('[data-theme-preset="aspen"]')) return
+    const column = element.closest('.slot-main') ?? element.closest('#content')
+    if (!column) return
+    const measure = () => {
+      if (window.innerWidth < 1024) { setPlacement(undefined); return }
+      const rect = column.getBoundingClientRect()
+      const left = Math.max(16, rect.left)
+      setPlacement({ left, width: Math.max(0, Math.min(rect.width, window.innerWidth - left - 16)) })
+    }
+    measure()
+    const observer = new ResizeObserver(measure)
+    observer.observe(column)
+    window.addEventListener('resize', measure)
+    return () => { observer.disconnect(); window.removeEventListener('resize', measure) }
+  }, [enabled, context.url])
+  if (!enabled || context.url.endsWith('/ask')) return null
+  return <>{placement && <div className='sm-assistant-inline-spacer' aria-hidden='true' />}<form ref={form} className='sm-assistant-inline' data-floating={placement ? 'true' : undefined} style={placement} onSubmit={event => {
+    event.preventDefault()
+    if (!question.trim()) return
+    openDocumentationAssistant(context)
+    void sendQuestion(question, context)
+    setQuestion('')
+  }}><input aria-label='Ask a question about this page' placeholder='Ask a question…' maxLength={2_000} value={question} onChange={event => setQuestion(event.target.value)} required /><button type='submit' aria-label='Send message' disabled={!question.trim()}>↑</button></form></>
+}
+
+export function DocumentationAssistantDrawer() {
+  const snapshot = useAssistant()
+  const context = useDocumentationContext()
+  const enabled = useDocumentationAssistantEnabled()
+  const dialog = useRef<HTMLDivElement>(null)
+  const input = useRef<HTMLTextAreaElement>(null)
+  useEffect(() => {
+    if (!enabled) return
+    const shortcut = (event: KeyboardEvent) => {
+      if ((event.ctrlKey || event.metaKey) && !event.altKey && event.key.toLowerCase() === 'i') {
+        event.preventDefault()
+        if (state.open) update({ open: false })
+        else openDocumentationAssistant(context)
+      }
+    }
+    document.addEventListener('keydown', shortcut)
+    return () => document.removeEventListener('keydown', shortcut)
+  }, [enabled, context.url, context.title])
+  useEffect(() => {
+    if (!snapshot.open || !enabled) return
+    const previous = document.activeElement as HTMLElement | null
+    const overflow = document.body.style.overflow
+    document.body.style.overflow = 'hidden'
+    input.current?.focus()
+    const keydown = (event: KeyboardEvent) => {
+      if (event.key === 'Escape') { event.preventDefault(); update({ open: false }) }
+      if (event.key !== 'Tab') return
+      const elements = Array.from(dialog.current?.querySelectorAll<HTMLElement>('button:not(:disabled), a[href], textarea:not(:disabled), input:not(:disabled)') ?? [])
+      const first = elements[0], last = elements.at(-1)
+      if (event.shiftKey && (document.activeElement === first || !dialog.current?.contains(document.activeElement))) { event.preventDefault(); last?.focus() }
+      else if (!event.shiftKey && (document.activeElement === last || !dialog.current?.contains(document.activeElement))) { event.preventDefault(); first?.focus() }
+    }
+    document.addEventListener('keydown', keydown)
+    return () => { document.removeEventListener('keydown', keydown); document.body.style.overflow = overflow; previous?.focus() }
+  }, [snapshot.open, enabled])
+  if (!snapshot.open || !enabled) return null
+  return <div className='sm-assistant-backdrop' onClick={event => { if (event.target === event.currentTarget) update({ open: false }) }}>
+    <div ref={dialog} role='dialog' aria-modal='true' aria-labelledby='supermemory-assistant-title' className='sm-assistant-drawer'>
+      <div className='sm-assistant-drawer-header'><h2 id='supermemory-assistant-title'>Ask Assistant</h2><button type='button' aria-label='Close assistant' onClick={() => update({ open: false })}>×</button></div>
+      <p className='sm-assistant-context'>About: {snapshot.context?.title ?? context.title}</p>
+      <Conversation context={snapshot.context ?? context} inputRef={input} />
+    </div>
+  </div>
+}

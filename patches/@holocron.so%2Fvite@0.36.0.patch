@@ -0,0 +1,111 @@
+'use client'
+
+import React, { useCallback, useEffect, useMemo, useRef, useState, useSyncExternalStore } from 'react'
+import { router } from 'spiceflow/react'
+import { useHolocronData } from '../../router.ts'
+import { buildSearchEntries } from '../../site-data.ts'
+import { createSearchDb, searchSidebar } from '../../lib/search.ts'
+import { SearchIcon } from '../markdown/icons.tsx'
+import { Link } from '../link.tsx'
+import { withBasePath } from '../../lib/holocron-url.ts'
+
+export function useShortcutModifier() {
+  return useSyncExternalStore(
+    () => () => {},
+    () => /Mac|iPhone|iPad|iPod/.test(navigator.platform) ? '⌘' : 'Ctrl',
+    () => 'Ctrl',
+  )
+}
+
+export function GlobalSearch() {
+  const { site } = useHolocronData()
+  const modifier = useShortcutModifier()
+  const dialog = useRef<HTMLDialogElement>(null)
+  const input = useRef<HTMLInputElement>(null)
+  const [query, setQuery] = useState('')
+  const [selected, setSelected] = useState(0)
+  const [content, setContent] = useState<Record<string, string>>({})
+  const [loading, setLoading] = useState(false)
+  const [indexError, setIndexError] = useState(false)
+  const pendingIndex = useRef<Promise<void> | null>(null)
+  const entries = useMemo(() => buildSearchEntries({ ...site, switchers: { versions: [], dropdowns: [] } }).map(entry => ({
+    ...entry,
+    searchText: entry.pageHref === null ? `${entry.searchText} ${content[entry.href] ?? ''}` : entry.searchText,
+  })), [site, content])
+  const db = useMemo(() => createSearchDb({ entries }), [entries])
+  const results = useMemo(() => {
+    const state = searchSidebar({ db, query, entries })
+    if (!state) return []
+    const seen = new Set<string>()
+    return entries.filter((entry) => {
+      if (!state.matchedHrefs.has(entry.href) || seen.has(entry.href)) return false
+      seen.add(entry.href)
+      return true
+    }).slice(0, 20)
+  }, [db, query, entries])
+
+  const open = useCallback(() => {
+    dialog.current?.showModal()
+    input.current?.focus()
+    if (site.config.theme !== 'aspen' || pendingIndex.current) return
+    setLoading(true)
+    setIndexError(false)
+    pendingIndex.current = fetch(withBasePath('/search-index.json'), { signal: AbortSignal.timeout(15_000) })
+      .then(async response => {
+        if (!response.ok) throw new Error('Search index unavailable')
+        const value: unknown = await response.json()
+        if (!value || typeof value !== 'object' || Array.isArray(value) || !Object.values(value).every(text => typeof text === 'string')) throw new Error('Invalid search index')
+        setContent(value as Record<string, string>)
+      })
+      .catch(() => { pendingIndex.current = null; setIndexError(true) })
+      .finally(() => setLoading(false))
+  }, [site.config.theme])
+
+  useEffect(() => {
+    const onKeyDown = (event: KeyboardEvent) => {
+      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
+        event.preventDefault()
+        open()
+      }
+    }
+    document.addEventListener('keydown', onKeyDown)
+    return () => document.removeEventListener('keydown', onKeyDown)
+  }, [open])
+
+  return (
+    <>
+      <button type='button' id='search-bar-entry' className='slot-global-search flex items-center gap-2 rounded-md bg-muted px-3 py-2 text-sm text-muted-foreground' aria-label='Open search' onClick={open}>
+        <SearchIcon />
+        <span>Search...</span>
+        <kbd className='ml-auto text-xs'>{modifier} K</kbd>
+      </button>
+      <dialog ref={dialog} aria-label='Search documentation' className='slot-search-dialog fixed top-[15vh] mx-auto w-[min(640px,calc(100vw-32px))] rounded-xl border border-border bg-background p-0 text-foreground shadow-xl backdrop:bg-black/40' onClick={(event) => { if (event.target === dialog.current) dialog.current?.close() }}>
+        <div className='flex items-center gap-3 border-b border-border p-4'>
+          <SearchIcon />
+          <input ref={input} type='search' aria-label='Search documentation' placeholder='Search documentation...' value={query} className='min-w-0 flex-1 bg-transparent outline-none' onChange={(event) => { setQuery(event.target.value); setSelected(0) }} onKeyDown={(event) => {
+            if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+              event.preventDefault()
+              setSelected((index) => results.length ? (index + (event.key === 'ArrowDown' ? 1 : -1) + results.length) % results.length : 0)
+            } else if (event.key === 'Enter' && results[selected]) {
+              event.preventDefault()
+              router.push(results[selected].href)
+              dialog.current?.close()
+            }
+          }} />
+          <button type='button' aria-label='Close search' className='rounded border border-border px-2 py-1 text-xs' onClick={() => dialog.current?.close()}>Esc</button>
+        </div>
+        <div className='max-h-[60vh] overflow-y-auto p-2' aria-live='polite'>
+          {results.map((entry, index) => (
+            <Link key={entry.href} href={entry.href} data-active={selected === index || undefined} className={`block rounded-md px-3 py-2 no-underline ${selected === index ? 'bg-muted' : 'hover:bg-muted'}`} onClick={() => dialog.current?.close()}>
+              <span className='block text-sm font-medium'>{entry.label}</span>
+              <span className='block text-xs text-muted-foreground'>{entry.groupPath?.split('\0').filter(Boolean).join(' / ') || entry.href}</span>
+            </Link>
+          ))}
+          {loading && <p role='status' className='px-4 py-2 text-sm text-muted-foreground'>Loading documentation text…</p>}
+          {indexError && <p role='status' className='px-4 py-2 text-sm text-muted-foreground'>Full-text search is temporarily unavailable. Page titles and headings are still searchable.</p>}
+          {!results.length && !loading && <p className='p-4 text-sm text-muted-foreground'>{query.trim() ? 'No results found.' : 'Search across the documentation.'}</p>}
+        </div>
+      </dialog>
+    </>
+  )
+}

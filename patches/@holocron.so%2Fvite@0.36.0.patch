index 0000000000000000000000000000000000000000..55f5408423a52485768cb6d1e0a241d08b609f9b
--- /dev/null
+++ b/src/lib/openapi/operation-examples.ts
@@ -0,0 +1,147 @@
+import type { APIExamplesOptions } from '../../config.ts'
+import { sample } from '../sample.ts'
+import { extractCodeSamples, toFenceLang } from './code-samples.ts'
+
+export function projectSchema(
+  schema: Record<string, unknown>,
+  seen = new Set<object>(),
+  depth = 0,
+): Record<string, unknown> {
+  if (!schema || typeof schema !== 'object') return schema
+  if (seen.has(schema) || depth > 12)
+    return {
+      type: schema.type ?? 'object',
+      title: schema.title,
+      description: [
+        schema.description,
+        'Recursive or deeply nested schema: use JSON input for additional levels. See the complete OpenAPI specification.',
+      ]
+        .filter(Boolean)
+        .join(' '),
+    }
+  const ancestors = new Set(seen).add(schema)
+  const result: Record<string, unknown> = {}
+  for (const key of [
+    'type',
+    'format',
+    'description',
+    'required',
+    'properties',
+    'items',
+    'enum',
+    'default',
+    'example',
+    'oneOf',
+    'anyOf',
+    'allOf',
+    'additionalProperties',
+    'nullable',
+    'deprecated',
+    'minimum',
+    'maximum',
+    'exclusiveMinimum',
+    'exclusiveMaximum',
+    'minLength',
+    'maxLength',
+    'minItems',
+    'maxItems',
+    'pattern',
+    'title',
+    'const',
+    'readOnly',
+    'writeOnly',
+  ]) {
+    if (!(key in schema)) continue
+    const value = schema[key]
+    if (key === 'properties' && value && typeof value === 'object')
+      result[key] = Object.fromEntries(
+        Object.entries(value).map(([name, child]) => [
+          name,
+          projectSchema(child as Record<string, unknown>, ancestors, depth + 1),
+        ]),
+      )
+    else if (
+      (key === 'items' || key === 'additionalProperties') &&
+      value &&
+      typeof value === 'object'
+    )
+      result[key] = projectSchema(
+        value as Record<string, unknown>,
+        ancestors,
+        depth + 1,
+      )
+    else if (['oneOf', 'anyOf', 'allOf'].includes(key) && Array.isArray(value))
+      result[key] = value.map((child) =>
+        projectSchema(child, ancestors, depth + 1),
+      )
+    else result[key] = value
+  }
+  return result
+}
+
+export function requestSchema(
+  schema: Record<string, unknown>,
+  options?: APIExamplesOptions,
+): Record<string, unknown> {
+  const result = { ...schema }
+  if (schema.properties && typeof schema.properties === 'object') {
+    const required = Array.isArray(schema.required) ? schema.required : []
+    result.properties = Object.fromEntries(
+      Object.entries(schema.properties)
+        .filter(
+          ([name, child]) =>
+            !(child as Record<string, unknown>).readOnly &&
+            (options?.defaults !== 'required' || required.includes(name)),
+        )
+        .map(([name, child]) => [
+          name,
+          requestSchema(child as Record<string, unknown>, options),
+        ]),
+    )
+  }
+  if (schema.items && typeof schema.items === 'object')
+    result.items = requestSchema(
+      schema.items as Record<string, unknown>,
+      options,
+    )
+  for (const key of ['oneOf', 'anyOf', 'allOf'])
+    if (Array.isArray(schema[key]))
+      result[key] = schema[key].map((child) => requestSchema(child, options))
+  return result
+}
+
+export function schemaExample(
+  schema: Record<string, unknown>,
+  options?: APIExamplesOptions,
+  request = false,
+) {
+  const projected = projectSchema(schema)
+  return sample(request ? requestSchema(projected, options) : projected)
+}
+
+export function requestCodeSamples(
+  operation: object,
+  curl: string,
+  options?: APIExamplesOptions,
+) {
+  const authored = extractCodeSamples(operation)
+  if (!options)
+    return [{ lang: 'bash', label: 'cURL', source: curl }, ...authored]
+  const samples = authored.some(
+    (sample) => sample.lang === 'bash' && /^\s*curl\b/.test(sample.source),
+  )
+    ? authored
+    : [{ lang: 'bash', label: 'cURL', source: curl }, ...authored]
+  let bashSeen = false
+  const deduplicated = samples.filter((sample) => {
+    if (sample.lang !== 'bash' || !/^\s*curl\b/.test(sample.source)) return true
+    if (bashSeen) return false
+    bashSeen = true
+    return true
+  })
+  return options?.languages
+    ? [...new Set(options.languages.map(toFenceLang))].flatMap((lang) =>
+        deduplicated.filter((sample) => sample.lang === lang),
+      )
+    : deduplicated
+}

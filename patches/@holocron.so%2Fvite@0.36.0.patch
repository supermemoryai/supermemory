+'use client'
+
+import type { CSSProperties } from 'react'
+import { useHolocronDataSafe } from '../../router.ts'
+import { withBasePath } from '../../lib/holocron-url.ts'
+import { Image } from './image.tsx'
+
+export function EditorialHtmlImage(props: {
+  src: string
+  alt: string
+  width?: string | number
+  height?: string | number
+  intrinsicWidth?: string | number
+  intrinsicHeight?: string | number
+  placeholder?: string
+  className?: string
+  style?: CSSProperties
+  loading?: 'lazy' | 'eager'
+}) {
+  const aspen = useHolocronDataSafe()?.site?.config?.theme === 'aspen'
+  if (!aspen) return <Image {...props} className={props.className || ''} />
+  const { intrinsicWidth, intrinsicHeight, placeholder, ...attributes } = props
+  return <img {...attributes} src={withBasePath(props.src)} />
+}
